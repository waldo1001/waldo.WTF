<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  waldo.WTF — nightly cold backup to the NAS (the NAS is backup-only now).
  Runs deploy/wtf-backup.sh at 03:30 local daily: hot WAL-safe snapshot of the
  lake + auth + whatsapp-archive -> dated dir on the NAS, prune to 14 days.

  Install (root):
    sudo cp deploy/com.waldo.wtf.backup.plist /Library/LaunchDaemons/com.waldo.wtf.backup.plist
    sudo chown root:wheel /Library/LaunchDaemons/com.waldo.wtf.backup.plist
    sudo chmod 644       /Library/LaunchDaemons/com.waldo.wtf.backup.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/com.waldo.wtf.backup.plist
  Run on demand: sudo launchctl kickstart system/com.waldo.wtf.backup
  Logs: /Users/waldo/waldo-wtf/logs/backup.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.waldo.wtf.backup</string>

    <key>UserName</key>
    <string>waldo</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/waldo/Sourcecode/waldo.wtf/deploy/wtf-backup.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/waldo</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/waldo/waldo-wtf/logs/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/waldo/waldo-wtf/logs/backup.log</string>
</dict>
</plist>
